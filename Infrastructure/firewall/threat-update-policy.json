{
  "schema_version": 1,
  "status": "proposed_only",
  "firmware": {
    "channel": "production",
    "check_interval_hours": 24,
    "automatic_install": false,
    "configuration_backup_required": true,
    "major_upgrade_requires_console_recovery": true
  },
  "suricata": {
    "initial_mode": "IDS_ALERT_ONLY",
    "update_interval_hours": 4,
    "maximum_staleness_hours": 12,
    "validate_before_activate": true,
    "retain_last_known_good": true,
    "automatic_rollback_on_load_failure": true,
    "minimum_enabled_feeds": 2
  },
  "dns_blocking": {
    "resolver": "Unbound",
    "update_interval_hours": 24,
    "maximum_staleness_hours": 36,
    "validate_before_activate": true,
    "retain_last_known_good": true
  },
  "monitoring": {
    "alert_on_update_failure": true,
    "alert_on_stale_feed": true,
    "alert_on_ips_engine_stopped": true,
    "alert_on_configuration_change": true,
    "local_ai_summary_is_advisory": true,
    "local_ai_may_change_rules": false
  }
}
