// Copy this file to Config/Local.xcconfig on each Mac and replace the placeholder values.
// This file is safe to commit because it contains placeholders only.

QB_CLIENT_ID = ABCHxXFCYpnkZSYq3BemmzGhVQ4tm63jDIvo6UxjQMeHgO8jmF
// Never place a production QuickBooks client secret in an iOS build setting.
// Set it only in the backend process environment; the OAuth callback bridge performs token exchange server-side.
QB_REDIRECT_URI = https://gunnaire.com/wp-json/ga/v1/qbo/oauth/callback
QB_CALLBACK_SCHEME = gunnaireops
QB_ENVIRONMENT = production
QB_ENABLE_PAYMENTS_SCOPE = true
QB_TIME_ACTIVITY_SYNC_ENABLED = true
QB_TIME_ACTIVITY_ITEM_REF =
QB_TIME_ACTIVITY_PAYROLL_ITEM_REF =
QB_TIME_ACTIVITY_PROJECT_REF =

GOOGLE_CLIENT_ID = 539751190237-fcff9hocl8rodfea25ilvld23j6vnhvm.apps.googleusercontent.com
GOOGLE_REDIRECT_URI = com.googleusercontent.apps.539751190237-fcff9hocl8rodfea25ilvld23j6vnhvm:/oauth2redirect
GOOGLE_CALLBACK_SCHEME = gunnaireops
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.539751190237-fcff9hocl8rodfea25ilvld23j6vnhvm
GOOGLE_ALLOWED_HOSTED_DOMAIN = gunnaire.com
GOOGLE_iOS_URL_SCHEME = com.googleusercontent.apps.539751190237-fcff9hocl8rodfea25ilvld23j6vnhvm

GUNNAIRE_BACKEND_BASE_URL = http:/$()/macstudio.local:8787
GUNNAIRE_BACKEND_API_TOKEN = replace-with-a-long-random-token
GUNNAIRE_BACKEND_AUTH_MODE = api-token
