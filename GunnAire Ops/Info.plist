<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>www.gunnaire.com.GunnAire-Ops</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(QB_CALLBACK_SCHEME)</string>
				<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>GOOGLE_CALLBACK_SCHEME</key>
	<string>$(GOOGLE_CALLBACK_SCHEME)</string>
	<key>GOOGLE_CLIENT_ID</key>
	<string>$(GOOGLE_CLIENT_ID)</string>
	<key>GOOGLE_REVERSED_CLIENT_ID</key>
	<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
	<key>GOOGLE_REDIRECT_URI</key>
	<string>$(GOOGLE_REDIRECT_URI)</string>
	<key>GUNNAIRE_BACKEND_API_TOKEN</key>
	<string>$(GUNNAIRE_BACKEND_API_TOKEN)</string>
	<key>GUNNAIRE_BACKEND_BASE_URL</key>
	<string>$(GUNNAIRE_BACKEND_BASE_URL)</string>
	<key>GUNNAIRE_BACKEND_AUTH_MODE</key>
	<string>$(GUNNAIRE_BACKEND_AUTH_MODE)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.business</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>MinimumOSVersion</key>
	<string>$(IPHONEOS_DEPLOYMENT_TARGET)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Capture receipt photos to attach to customer payments and vendor bills.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect to the GunnAire Mac Studio backend for shared users, roles, and document uploads.</string>
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.gunnaire.businesssuite.field-payment-handoff</string>
	</array>
	<key>QB_CALLBACK_SCHEME</key>
	<string>$(QB_CALLBACK_SCHEME)</string>
	<key>QB_CLIENT_ID</key>
	<string>$(QB_CLIENT_ID)</string>
	<key>QB_DEFAULT_ITEM_REF</key>
	<string>$(QB_DEFAULT_ITEM_REF)</string>
	<key>QB_DEFAULT_INCOME_ACCOUNT_REF</key>
	<string>$(QB_DEFAULT_INCOME_ACCOUNT_REF)</string>
	<key>QB_DEFAULT_EXPENSE_ACCOUNT_REF</key>
	<string>$(QB_DEFAULT_EXPENSE_ACCOUNT_REF)</string>
	<key>QB_DEFAULT_PAYMENT_ACCOUNT_REF</key>
	<string>$(QB_DEFAULT_PAYMENT_ACCOUNT_REF)</string>
	<key>QB_ENABLE_PAYMENTS_SCOPE</key>
	<string>$(QB_ENABLE_PAYMENTS_SCOPE)</string>
	<key>QB_ENVIRONMENT</key>
	<string>$(QB_ENVIRONMENT)</string>
	<key>QB_REDIRECT_URI</key>
	<string>$(QB_REDIRECT_URI)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
